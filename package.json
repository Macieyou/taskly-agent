{
  "name": "taskly-quality-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint frontend backend agent eslint.config.mjs --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write frontend backend agent eslint.config.mjs package.json .prettierrc.json",
    "format:check": "prettier --check frontend backend agent eslint.config.mjs package.json .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
